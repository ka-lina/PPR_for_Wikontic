# Dockerfile - Development version
ARG CUDA_VERSION=12.4.1
ARG UBUNTU_VERSION=22.04
ARG PYTHON_VERSION=3.10
ARG NVIDIA_IMAGE_VERSION=${CUDA_VERSION}-devel-ubuntu22.04

FROM nvidia/cuda:${NVIDIA_IMAGE_VERSION}
#{CUDA_VERSION}-cudnn8-devel-ubuntu${UBUNTU_VERSION}

ARG PYTHON_VERSION
ARG DEBIAN_FRONTEND=noninteractive

# Install Python and basic tools
RUN apt-get update && apt-get install -y \
    software-properties-common \
    wget \
    curl \
    git \
    build-essential \
    vim \
    htop \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip in virtual environment
RUN pip install --upgrade pip

WORKDIR /workspace

# Clone repositories (only once at build time)
RUN git clone https://github.com/OSU-NLP-Group/HippoRAG.git \
    && git clone https://github.com/screemix/Wikontic.git

# Install PyTorch first
RUN pip install --no-cache-dir \
    torch==2.4.1 \
    --index-url https://download.pytorch.org/whl/cu$(echo ${CUDA_VERSION} | cut -d. -f1-2 | tr -d '.')

# Copy consolidated requirements
COPY requirements.txt /tmp/requirements.txt

# Install common dependencies
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Install HippoRAG via pip
RUN cd /workspace/HippoRAG && \
    pip install --no-cache-dir --no-deps -e . && \
    pip install --no-deps hipporag 

# Install Wikontic (but not its requirements - we already have them)
RUN cd /workspace/Wikontic && \
    pip install --no-cache-dir --no-deps -e .

# Install development tools
RUN pip install --no-cache-dir \
    ipython \
    jupyter \
    pytest \
    black \
    ipdb

# Set Python path
ENV PYTHONPATH="/workspace:/workspace/HippoRAG:/workspace/Wikontic:${PYTHONPATH}"
ENV CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0}

# Create scripts directory and copy init script
RUN mkdir -p /scripts
COPY scripts/init-db.py /scripts/init-db.py
RUN chmod +x /scripts/init-db.py

# Verify installations
RUN python -c "import torch; print(f'PyTorch {torch.__version__} with CUDA {torch.version.cuda}')" && \
    python -c "import transformers; print(f'Transformers {transformers.__version__}')"

WORKDIR /workspace

# Default command for development (bash shell)
CMD ["/bin/bash"]